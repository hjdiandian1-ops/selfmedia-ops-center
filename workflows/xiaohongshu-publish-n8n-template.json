{
  "name": "小红书AI自动化发布工作流",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "schedule-trigger-1",
      "name": "定时触发器 (每日)"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-publish",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "id": "webhook-trigger-1",
      "name": "Webhook 手动/外部触发"
    },
    {
      "parameters": {
        "jsCode": "// 模拟选题与素材数据\nreturn [\n  {\n    json: {\n      topic: \"个人开发者如何用 AI 搭建小红书自动化发布系统\",
      target_audience: \"自媒体博主/极客/程序员\",
      style: \"瑞士极简风\",
      images: [\n        \"/data/shared/slide1.png\",\n        \"/data/shared/slide2.png\"\n      ]\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "id": "code-topic-1",
      "name": "选题与素材数据准备"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_DEEPSEEK_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是一位顶级小红书爆款文案操盘手。请根据主题生成：1. 强吸引力的爆款标题（带 Emoji） 2. 具备 Hook-Value-CTA 结构的正文 3. 3-5个高权重标签。格式为纯 JSON。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"主题：{{ $json.topic }}，受众：{{ $json.target_audience }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "id": "http-ai-writer",
      "name": "AI 爆款文案生成 (DeepSeek)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://xhs-publisher:8000/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json.body.choices[0].message.content ? JSON.parse($json.body.choices[0].message.content).title : 'AI 自动化发布系统' }}\",\n  \"content\": \"{{ $json.body.choices[0].message.content ? JSON.parse($json.body.choices[0].message.content).content : '内容自动生成中...' }}\",\n  \"images\": [\n    \"/data/shared/slide1.png\",\n    \"/data/shared/slide2.png\"\n  ],\n  \"tags\": [\"AI大模型\", \"自媒体运营\", "n8n"],\n  \"cookies_json_path\": \"/data/shared/xhs_cookies.json\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "id": "http-xhs-publish",
      "name": "自动发布到小红书 (Playwright Worker)"
    }
  ],
  "connections": {
    "定时触发器 (每日)": {
      "main": [
        [
          {
            "node": "选题与素材数据准备",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook 手动/外部触发": {
      "main": [
        [
          {
            "node": "选题与素材数据准备",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "选题与素材数据准备": {
      "main": [
        [
          {
            "node": "AI 爆款文案生成 (DeepSeek)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI 爆款文案生成 (DeepSeek)": {
      "main": [
        [
          {
            "node": "自动发布到小红书 (Playwright Worker)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
