# n8n NAS 部署环境变量配置

# 0. NAS 连接与发布凭据（scripts/publish_to_n8n.py 读取，严禁在代码中硬编码）
NAS_IP=192.168.1.100
NAS_SSH_PORT=233
NAS_USER=your_nas_username
NAS_PASS=your_nas_password
NAS_SHARED_DIR=/volume1/docker/n8n/shared_files
XHS_PUBLISHER_PORT=5800

# 飞书自建应用与多维表格 (Feishu Base) 配置
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=app_token_xxxxxxxxxxxx
FEISHU_TABLE_ID=tbl_xxxxxxxxxxxx

# 1. 基础数据库配置
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secure_password_2026
POSTGRES_DB=n8n

# 2. n8n 服务配置
N8N_PORT=5678
N8N_PROTOCOL=http
# 如果你在局域网访问，填写你的 NAS 局域网 IP（如 192.168.1.100）
# 如果开启了 DDNS / 域名外网访问，填写对应域名
N8N_HOST=192.168.1.100
WEBHOOK_URL=http://192.168.1.100:5678/
