{
  "name": "爆款选题与热点抓取雷达 (Feishu Btable Version)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "id": "schedule-trigger",
      "name": "定时触发 (每4小时)"
    },
    {
      "parameters": {
        "url": "http://rsshub:1200/36kr/newsflashes",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "id": "fetch-rss-36kr",
      "name": "抓取 36Kr 科技快讯 RSS"
    },
    {
      "parameters": {
        "jsCode": "// 格式化解析 RSS 数据并提取前 5 条热点\nconst items = $input.all();\nconst results = [];\nfor (const item of items) {\n  results.push({\n    json: {\n      title: item.json.title || '无标题',\n      link: item.json.link || '',\n      pubDate: item.json.pubDate || new Date().toISOString(),\n      description: (item.json.description || '').replace(/<[^>]+>/g, '').slice(0, 300)\n    }\n  });\n}\nreturn results.slice(0, 5);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "id": "format-news",
      "name": "格式化提炼数据"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"app_id\": \"{{ $env.FEISHU_APP_ID }}\",\n  \"app_secret\": \"{{ $env.FEISHU_APP_SECRET }}\"\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ],
      "id": "get-feishu-token",
      "name": "步骤 1: 获取飞书 Token"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://open.feishu.cn/open-apis/bitable/v1/apps/{{ $env.FEISHU_APP_TOKEN }}/tables/{{ $env.FEISHU_TABLE_ID }}/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.tenant_access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"选题标题\": \"{{ $('format-news').item.json.title }}\",\n    \"来源平台\": \"36Kr/RSS\",\n    \"爆款热度分\": 85,\n    \"AI 核心摘要\": \"{{ $('format-news').item.json.description }}\",\n    \"推荐创作方向\": [\"AI工具测评\"],\n    \"适用平台\": [\"小红书\", \"公众号\"],\n    \"选题状态\": \"🆕 待筛选\",\n    \"原始链接\": \"{{ $('format-news').item.json.link }}\"\n  }\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ],
      "id": "write-to-bitable",
      "name": "步骤 2: 写入飞书多维表格"
    }
  ],
  "connections": {
    "schedule-trigger": {
      "main": [
        [
          {
            "node": "fetch-rss-36kr",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fetch-rss-36kr": {
      "main": [
        [
          {
            "node": "format-news",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "format-news": {
      "main": [
        [
          {
            "node": "get-feishu-token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "get-feishu-token": {
      "main": [
        [
          {
            "node": "write-to-bitable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
