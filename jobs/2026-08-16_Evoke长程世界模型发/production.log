+          <td style="padding:9px 8px;font-size:13px;line-height:1.5;color:#1C1917;"><span leaf="">140 亿（14B）</span></td>
+        </tr>
+        <tr style="border-top:1px solid #F5F5F5;">
+          <td style="padding:9px 8px;font-size:13px;line-height:1.5;color:#6B7280;"><span leaf="">去噪步数</span></td>
+          <td style="padding:9px 8px;font-size:13px;line-height:1.5;color:#DC2626;font-weight:800;"><span leaf="">3 步，零 CFG</span></td>
+        </tr>
+        <tr style="border-top:1px solid #F5F5F5;">
+          <td style="padding:9px 8px;font-size:13px;line-height:1.5;color:#6B7280;"><span leaf="">生成速度</span></td>
+          <td style="padding:9px 8px;font-size:13px;line-height:1.5;color:#1C1917;"><span leaf="">1.5 秒分块 / 2.11 秒（单张 H200）</span></td>
+        </tr>
+        <tr style="border-top:1px solid #F5F5F5;">
+          <td style="padding:9px 8px;font-size:13px;line-height:1.5;color:#6B7280;"><span leaf="">记忆窗口</span></td>
