+        <section>
+          <p style="font-size:10px;color:#DC2626;font-weight:700;letter-spacing:3px;margin:0 0 2px;"><span leaf="">MECHANISM</span></p>
+          <h3 style="font-size:18px;font-weight:800;color:#1C1917;margin:0;"><span leaf="">机制解剖：为什么记住这么难</span></h3>
+        </section>
+      </section>
