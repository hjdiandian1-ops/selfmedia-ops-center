+          <td style="width:33%;padding:8px 4px;text-align:center;"><section style="font-size:24px;font-weight:900;color:#DC2626;"><span leaf="">2.11秒</span></section><section style="font-size:12px;color:#6B7280;margin-top:4px;"><span leaf="">生成 1.5 秒视频</span></section></td>
+          <td style="width:33%;padding:8px 4px;text-align:center;"><section style="font-size:24px;font-weight:900;color:#DC2626;"><span leaf="">2小时</span></section><section style="font-size:12px;color:#6B7280;margin-top:4px;"><span leaf="">连续会话不崩</span></section></td>
