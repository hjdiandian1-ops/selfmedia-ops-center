#!/usr/bin/env python3
"""调用智谱 GLM 视觉模型识别本地图片。

用法:
    python3 glm_vision.py <图片路径> ["提示词"] [--model 模型名]

脚本自动读取同目录上级 config.json 中的 API key 和默认模型。
"""

import argparse
import base64
import json
import mimetypes
import os
import sys
import time
import urllib.error
import urllib.request

DEFAULT_ENDPOINT = "https://open.bigmodel.cn/api/paas/v4/chat/completions"
DEFAULT_MODEL = "glm-4.6v-flash"
MAX_RETRIES = 3
RETRY_SLEEP_SECONDS = 8


def load_config():
    skill_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    cfg_path = os.path.join(skill_dir, "config.json")
    with open(cfg_path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def encode_image(path):
    with open(path, "rb") as fh:
        raw = fh.read()
    mime, _ = mimetypes.guess_type(path)
    if not mime or not mime.startswith("image/"):
        mime = "image/jpeg"
    return "data:%s;base64,%s" % (mime, base64.b64encode(raw).decode("ascii"))


def main():
    parser = argparse.ArgumentParser(description="调用 GLM 视觉模型识别本地图片")
    parser.add_argument("image", help="本地图片路径")
    parser.add_argument("prompt", nargs="?", default="请详细描述这张图片的内容。")
    parser.add_argument("--model", help="模型名，默认取 config.json 的 default_model")
    parser.add_argument("--endpoint", default=DEFAULT_ENDPOINT)
    args = parser.parse_args()

    if not os.path.isfile(args.image):
        print("错误: 找不到图片文件: %s" % args.image, file=sys.stderr)
        sys.exit(2)

    cfg = load_config()
    model = args.model or cfg.get("default_model") or DEFAULT_MODEL
    api_key = cfg["api_key"]

    payload = {
        "model": model,
        "messages": [
            {
                "role": "user",
                "content": [
                    {"type": "image_url", "image_url": {"url": encode_image(args.image)}},
                    {"type": "text", "text": args.prompt},
                ],
            }
        ],
    }

    req = urllib.request.Request(
        args.endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": "Bearer " + api_key,
            "Content-Type": "application/json",
        },
        method="POST",
    )

    last_error = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                body = json.loads(resp.read().decode("utf-8"))
            break
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")
            last_error = "HTTP %s: %s" % (exc.code, detail)
            if exc.code == 429 and attempt < MAX_RETRIES:
                print("流量繁忙，%s 秒后重试 (%s/%s)..." % (RETRY_SLEEP_SECONDS, attempt, MAX_RETRIES), file=sys.stderr)
                time.sleep(RETRY_SLEEP_SECONDS)
                continue
            break
        except Exception as exc:
            last_error = "调用失败: %s" % exc
            break
    else:
        last_error = last_error or "未知错误"

    if last_error:
        print(last_error, file=sys.stderr)
        sys.exit(1)

    try:
        answer = body["choices"][0]["message"]["content"]
    except (KeyError, IndexError):
        print("响应格式异常: %s" % json.dumps(body, ensure_ascii=False), file=sys.stderr)
        sys.exit(1)

    print(answer)


if __name__ == "__main__":
    main()

