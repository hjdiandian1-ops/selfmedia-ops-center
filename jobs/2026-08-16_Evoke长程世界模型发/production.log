+        <tr><td colspan="2" style="padding:0 10px 10px;"><section style="background:#F5F5F5;border-radius:999px;height:8px;overflow:hidden;"><section style="width:32%;height:8px;background:#DC2626;border-radius:999px;"></section></section></td></tr>
