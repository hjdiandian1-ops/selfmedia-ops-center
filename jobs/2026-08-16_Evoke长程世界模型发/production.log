    # ---------- C6: AI 腔开头 ----------
    for p, v in draft_meta.items():
        body = re.sub(r"^---\s*\n.*?\n---\s*\n", "", v["text"], flags=re.S)
        body = re.sub(r"^#+ .*$", "", body, flags=re.M).strip()[:150]
