+        <tr><td style="padding:9px 10px 2px;font-size:13px;color:#6B7280;width:62%;"><span leaf="">回头重建提升</span></td><td style="padding:9px 10px 2px;text-align:right;font-size:13px;font-weight:800;color:#DC2626;width:38%;"><span leaf="">+2.3~3.2 dB</span></td></tr>
