                break

    # ---------- C7: 油腻/违禁短语 ----------
    for p, v in draft_meta.items():
        hits = [g for g in GREASY_PHRASES if g in v["text"]]
        if hits:
            report("FAIL", "C7-greasy", f"{os.path.basename(p)} 含违禁短语：{hits}")

    # ---------- C9: 平台成品硬指标（P0） ----------
    for p, v in draft_meta.items():
        plat = next(k for k in PLATFORM_DIRS if k in p)
