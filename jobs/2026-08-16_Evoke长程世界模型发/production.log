+        <tr><td style="padding:9px 10px 2px;font-size:13px;color:#6B7280;width:62%;"><span leaf="">传统多步去噪</span></td><td style="padding:9px 10px 2px;text-align:right;font-size:13px;font-weight:800;color:#DC2626;width:38%;"><span leaf="">50 步 + CFG</span></td></tr>
+        <tr><td colspan="2" style="padding:0 10px 10px;"><section style="background:#F5F5F5;border-radius:999px;height:8px;overflow:hidden;"><section style="width:100%;height:8px;background:#DC2626;border-radius:999px;"></section></section></td></tr>
+        <tr><td style="padding:9px 10px 2px;font-size:13px;color:#6B7280;width:62%;"><span leaf="">EVOKE 学生</span></td><td style="padding:9px 10px 2px;text-align:right;font-size:13px;font-weight:800;color:#DC2626;width:38%;"><span leaf="">3 步，零 CFG</span></td></tr>
+        <tr><td colspan="2" style="padding:0 10px 10px;"><section style="background:#F5F5F5;border-radius:999px;height:8px;overflow:hidden;"><section style="width:6%;height:8px;background:#DC2626;border-radius:999px;"></section></section></td></tr>
+        <tr><td style="padding:9px 10px 2px;font-size:13px;color:#6B7280;width:62%;"><span leaf="">中途改提示词生效</span></td><td style="padding:9px 10px 2px;text-align:right;font-size:13px;font-weight:800;color:#DC2626;width:38%;"><span leaf="">67%</span></td></tr>
+        <tr><td colspan="2" style="padding:0 10px 10px;"><section style="background:#F5F5F5;border-radius:999px;height:8px;overflow:hidden;"><section style="width:67%;height:8px;background:#DC2626;border-radius:999px;"></section></section></td></tr>
+        <tr><td style="padding:9px 10px 2px;font-size:13px;color:#6B7280;width:62%;"><span leaf="">已存区域想覆盖</span></td><td style="padding:9px 10px 2px;text-align:right;font-size:13px;font-weight:800;color:#DC2626;width:38%;"><span leaf="">4%</span></td></tr>
+        <tr><td colspan="2" style="padding:0 10px 10px;"><section style="background:#F5F5F5;border-radius:999px;height:8px;overflow:hidden;"><section style="width:4%;height:8px;background:#DC2626;border-radius:999px;"></section></section></td></tr>
+        <tr><td style="padding:9px 10px 2px;font-size:13px;color:#6B7280;width:62%;"><span leaf="">回头重建提升</span></td><td style="padding:9px 10px 2px;text-align:right;font-size:13px;font-weight:800;color:#DC2626;width:38%;"><span leaf="">+2.3~3.2 dB</span></td></tr>
+        <tr><td colspan="2" style="padding:0 10px 10px;"><section style="background:#F5F5F5;border-radius:999px;height:8px;overflow:hidden;"><section style="width:32%;height:8px;background:#DC2626;border-radius:999px;"></section></section></td></tr>
+      </table>
+      <section style="padding:12px 18px 14px;font-size:12px;color:#9CA3AF;border-top:1px dashed #F3E2E2;margin-top:12px;"><span leaf="">数据来源：arXiv 2608.13546 / AlphaXiv 解读（2026-08）</span></section>
+    </section>
+
+    <p><span leaf="">这不是一家在卷。世界模型赛道从年初就在挤：Genie 3、Kling、Wan 系、LingBot-World、Matrix-Game、HY-WorldPlay 相继出现。Alaya Lab 自己 7 月底刚发过 15B 的 AlayaWorld，8 月 12 日又发了 EVOKE。WBench 这个交互式基准上已经有 30 个模型、22 项指标、289 个用例，长时记忆成了整条赛道的公共考卷。</span></p>
+  </section>
+
+  <section style="padding:0 10px;">
+    <section style="height:1px;background:linear-gradient(to right,transparent,#FCA5A5,#DC2626,#FCA5A5,transparent);margin:0;"><span leaf=""><br></span></section>
+  </section>
+
+  <section style="margin-top:48px;margin-bottom:28px;padding:0 10px;">
+    <section style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;padding-bottom:14px;border-bottom:3px solid #DC2626;">
+      <section style="display:flex;align-items:center;">
+        <span style="display:inline-block;background:#DC2626;color:#FFFFFF;font-size:18px;font-weight:900;padding:4px 14px;border-radius:6px;margin-right:14px;line-height:1.3;"><span leaf="">03</span></span>
+        <section>
+          <p style="font-size:10px;color:#DC2626;font-weight:700;letter-spacing:3px;margin:0 0 2px;"><span leaf="">JUDGMENT</span></p>
+          <h3 style="font-size:18px;font-weight:800;color:#1C1917;margin:0;"><span leaf="">当生成趋近无限，什么会变贵</span></h3>
+        </section>
+      </section>
